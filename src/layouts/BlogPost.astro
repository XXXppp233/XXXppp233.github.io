---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCategoryHref, getTagHref } from '../utils/taxonomy';

interface Props extends CollectionEntry<'blog'>['data'] {
	categoryPosts?: CollectionEntry<'blog'>[];
	currentPostId?: string;
	headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, pubDate, updatedDate, heroImage, category, tags = [], categoryPosts = [], currentPostId, headings = [] } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(1440px, calc(100% - 2em));
				max-width: 100%;
				margin: 0;
				padding-top: 2em;
			}
			.reading-layout {
				display: grid;
				grid-template-columns: minmax(150px, 210px) minmax(0, 820px) minmax(150px, 210px);
				justify-content: center;
				gap: clamp(1rem, 3vw, 3.5rem);
			}
			.reading-content { min-width: 0; }
			.hero-image {
				width: 100%;
				margin: 0;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border: 5px solid var(--ink);
				border-radius: 34px 26px 40px 24px;
				box-shadow: 10px 11px 0 rgba(var(--ink-rgb), 0.18);
			}
			.prose {
				position: relative;
				width: 100%;
				max-width: none;
				margin: -3.2em auto 0;
				padding: clamp(1.2rem, 4vw, 2.4rem);
				color: rgb(var(--gray-dark));
				background:
					radial-gradient(circle at 10% 8%, rgba(255, 255, 255, 0.6), transparent 12rem),
					radial-gradient(circle at 90% 12%, rgba(30, 30, 30, 0.08), transparent 14rem),
					linear-gradient(145deg, rgba(247, 247, 241, 0.96), rgba(210, 210, 203, 0.86));
				border: 4px solid var(--ink);
				border-radius: 34px 28px 40px 24px;
				box-shadow: var(--box-shadow);
			}
			.title {
				position: relative;
				margin-bottom: 1em;
				padding: 0 0 1em;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--paint-red);
				font-size: 0.8em;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
			.last-updated-on {
				margin-top: 0.35em;
				color: rgb(var(--gray));
				font-style: italic;
			}
			.taxonomy {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5rem;
				margin: -0.35rem 0 1.2rem;
			}
			.taxonomy a {
				display: inline-flex;
				padding: 0.24em 0.68em;
				color: var(--ink);
				font-size: 0.78em;
				font-weight: 700;
				line-height: 1.35;
				text-decoration: none;
				background: rgba(247, 247, 241, 0.72);
				border: 2px solid rgba(var(--ink-rgb), 0.62);
				border-radius: 999px;
			}
			.taxonomy .category {
				color: var(--paper-light);
				background: var(--paint-brown);
				border-color: var(--ink);
			}
			.taxonomy a:hover {
				color: var(--paper-light);
				background: var(--paint-red);
				border-color: var(--ink);
				transform: translateY(-2px) rotate(-1deg);
			}
			.reading-sidebar {
				position: sticky;
				top: 1.5rem;
				align-self: start;
				max-height: calc(100vh - 3rem);
				overflow: auto;
				padding: .9rem .85rem 1rem;
				background: rgba(255, 253, 246, .82);
				border: 2px solid rgba(var(--ink-rgb), .72);
				border-radius: 1rem;
				box-shadow: 4px 5px 0 rgba(var(--ink-rgb), .12);
			}
			.reading-sidebar h2 {
				margin: 0 0 .7rem;
				font-size: .72rem;
				letter-spacing: .08em;
				line-height: 1.3;
				text-shadow: none;
				text-transform: uppercase;
			}
			.reading-sidebar ul { display: grid; gap: .25rem; margin: 0; padding: 0; list-style: none; }
			.reading-sidebar a { display: block; padding: .35rem .25rem; color: rgb(var(--gray-dark)); font-size: .77rem; font-weight: 700; line-height: 1.4; text-decoration: none; border-radius: .35rem; }
			.reading-sidebar a:hover { color: var(--ink); background: #f7e3a2; transform: translateX(2px); }
			.reading-sidebar a.current { color: #fffdf6; background: var(--ink); }
			.category-sidebar { border-top: 5px solid var(--earth-green); }
			.category-crumb { display: flex; align-items: center; gap: .3rem; margin: 0 0 .85rem; }
			.category-crumb a { padding: .28rem .4rem; color: var(--ink); font-size: .68rem; line-height: 1.2; background: #fffdf6; border: 1.5px solid var(--ink); border-radius: .35rem; }
			.category-crumb a:hover { background: #f7e3a2; transform: translateY(-1px); }
			.category-crumb span { color: rgb(var(--gray)); font-weight: 700; }
			.toc-sidebar { border-top: 5px solid var(--earth-blue); }
			.toc-sidebar a[data-depth="3"] { padding-left: .75rem; font-size: .72rem; }
			.toc-sidebar a[data-depth="4"] { padding-left: 1.25rem; font-size: .7rem; }
			.empty-note { margin: 0; color: rgb(var(--gray)); font-size: .75rem; line-height: 1.45; }
			@media (max-width: 720px) {
				main {
					width: 100%;
					padding-top: 1em;
				}
				.hero-image {
					width: calc(100% - 1em);
				}
				.prose {
					max-width: calc(100% - 1em);
					margin-top: -1.2em;
				}
			}
			@media (max-width: 1120px) {
				.reading-layout { grid-template-columns: minmax(0, 820px); }
				.reading-sidebar { display: none; }
			}
		</style>
	</head>

	<body>
		<main>
			<article class="reading-layout">
				<aside class="reading-sidebar category-sidebar" aria-label="同分类文章">
					<nav class="category-crumb" aria-label="分类导航">
						<a href="/">首页</a><span aria-hidden="true">›</span><a href={category ? getCategoryHref(category) : '/categories'}>{category || '分类'}</a>
					</nav>
					<h2>{category ? `${category} · 文章` : '同类文章'}</h2>
					{categoryPosts.length > 0 ? <ul>{categoryPosts.map((entry) => <li><a class:list={{ current: entry.id === currentPostId }} href={`/blog/${entry.id}/`}>{entry.data.title}</a></li>)}</ul> : <p class="empty-note">这个分类暂时没有文章。</p>}
				</aside>
				<div class="reading-content">
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							(category || tags.length > 0) && (
								<div class="taxonomy">
									{category && (
										<a class="category" href={getCategoryHref(category)}>
											{category}
										</a>
									)}
									{tags.map((tag) => (
										<a href={getTagHref(tag)}>#{tag}</a>
									))}
								</div>
							)
						}
						<hr />
					</div>
					<slot />
				</div>
				</div>
				<aside class="reading-sidebar toc-sidebar" aria-label="文章目录">
					<h2>本页目录</h2>
					{headings.length > 0 ? <ul>{headings.map((heading) => <li><a href={`#${heading.slug}`} data-depth={heading.depth} data-toc-link={heading.slug}>{heading.text}</a></li>)}</ul> : <p class="empty-note">本页没有章节目录。</p>}
				</aside>
			</article>
		</main>
		<Footer />
		<script>
			const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
			const tocHeadings = tocLinks
				.map((link) => ({ link, heading: document.getElementById(link.dataset.tocLink || '') }))
				.filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => item.heading instanceof HTMLElement);

			if (tocHeadings.length > 0) {
				let isTicking = false;
				const updateActiveHeading = () => {
					const readingLine = window.innerHeight * 0.32;
					let activeItem = tocHeadings[0];

					for (const item of tocHeadings) {
						if (item.heading.getBoundingClientRect().top <= readingLine) activeItem = item;
					}

					for (const item of tocHeadings) item.link.classList.toggle('current', item === activeItem);
					isTicking = false;
				};
				const requestUpdate = () => {
					if (!isTicking) {
						window.requestAnimationFrame(updateActiveHeading);
						isTicking = true;
					}
				};

				window.addEventListener('scroll', requestUpdate, { passive: true });
				window.addEventListener('resize', requestUpdate, { passive: true });
				requestUpdate();
			}
		</script>
	</body>
</html>
